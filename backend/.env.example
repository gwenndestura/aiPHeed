DATABASE_URL=sqlite+aiosqlite:///./aipheed.db
SECRET_KEY=changeme
MODEL_PATH=models
PSA_MAIN_URL=https://psa.gov.ph
PSA_RSSO_URL=https://rsso04a.psa.gov.ph
DATA_RAW_PATH=data/raw

# Serve /docs, /redoc and /openapi.json. Keep false outside local development.
ENABLE_API_DOCS=false

# Sessions: how long an admin stays signed in across reloads and new tabs.
# Idle = signed out after this long with no activity; max = signed out this
# long after signing in, however active. Both in seconds.
REFRESH_TOKEN_IDLE_TTL_SECONDS=28800
REFRESH_TOKEN_MAX_TTL_SECONDS=604800
# strict (default) needs the frontend and the API on the same site, e.g.
# app.example.ph + api.example.ph. Use none only for a cross-site deployment,
# and only after CORS_PREVIEW_REGEX is pinned to this project (QA_REPORT SEC-08).
REFRESH_COOKIE_SAMESITE=strict
# Leave true; it is relaxed automatically for plain http on localhost only.
REFRESH_COOKIE_SECURE=true

# Email for account links (sign-up verification, password reset) and notices.
# Leave SMTP_HOST empty during local development: the email, link included, is
# then printed in the backend terminal instead of being sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=your_smtp_username_here
SMTP_PASSWORD=your_smtp_password_here
SMTP_FROM=aiPHeed <no-reply@example.gov.ph>
# STARTTLS on SMTP_PORT (usually 587). Set SMTP_USE_SSL=true instead for port 465.
SMTP_USE_TLS=true
SMTP_USE_SSL=false
# The frontend's public address; the links in those emails point here.
FRONTEND_BASE_URL=http://localhost:8080

# View-only demo account for presentations. Create it with
#   python scripts/create_admin.py --demo
# It can sign in only while ENABLE_DEMO_ACCOUNT=true. Keep false when live.
ENABLE_DEMO_ACCOUNT=false
DEMO_ADMIN_EMAIL=demo.account@calabarzon.da.gov.ph
DEMO_ADMIN_PASSWORD=choose_a_long_passphrase_here

# ── News API Keys ─────────────────────────────────────────────────────────
# Google News RSS (already works — no key needed)
GNEWS_API_KEY=your_gnews_api_key_here

# ── Thesis rules that are OFF locally (switch on in the deployed environment) ──
# Rule 1 (p.48, schedule p.59): the quarterly self-update. 1 = start APScheduler with the app (02:00 PHT on the 15th
# of January, April, July and October). Off by default; see deploy/scheduler.env.example for the cron settings and
# AIPHEED_SCHEDULER_DRY_RUN=1 for a first test that writes nothing.
AIPHEED_ENABLE_SCHEDULER=0
# Rule 7 (p.49): when a DA administrator confirms an early-warning alert, one email goes to this DSWD 4A address
# (through the SMTP settings above). Empty = no notification is sent.
AIPHEED_DSWD_NOTIFY_EMAIL=
