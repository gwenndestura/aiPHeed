# aiPHeed thesis-demo configuration (FINAL_THESIS_SYSTEM_REPORT.md, section 10).
# Read by scripts/start_thesis_demo.py; can also be copied into backend/.env.
# AIPHEED_LEAD2_MODEL=thesis serves the final thesis system; AIPHEED_STRICT_MODEL=1 makes the API refuse to start
# if any required artifact is missing (no silent fallback to an older model).
# Rollback: remove both lines (or set AIPHEED_LEAD2_MODEL=e38) and restart: the E38 production default returns.
AIPHEED_LEAD2_MODEL=thesis
AIPHEED_STRICT_MODEL=1
