    <title>BFAR Home - Certification & Featured Systems</title>

    <style>
        body {
            font-family: 'DM Sans', sans-serif;
            background-color: #f4f6f9;
            margin: 0;
            padding: 20px 0;
        }

        .certification-wrapper {
            padding: 10px 10px;
            margin: 0 20px;
            box-sizing: border-box;
            display: flex;
            flex-wrap: wrap;
            gap: 20px;
            border-radius: 10px;
            justify-content: center;
            background-color: #fff;
        }

        .certification-section {
            padding: 20px;
            border-radius: 10px;
            flex: 1 1 calc(33.333% - 40px);
            box-sizing: border-box;
            display: flex;
            flex-direction: column;
        }

        .certification-heading {
            background-color: #03369D;
            padding: 15px 20px;
            border-radius: 8px;
            margin-bottom: 20px;
            text-align: center;
            box-shadow: 0 2px 6px rgba(0,0,0,.05);
            animation: bounceCard .6s ease;
        }

        .certification-heading p {
            margin: 0;
            font-size: 16px;
            font-weight: bold;
            color: #f0f4ff;
            animation: fadeInSlide .8s ease-out;
        }

        .certification-card-container {
            display: flex;
            flex-direction: column;
            gap: 15px;
        }

        .certification-card {
            display: flex;
            align-items: center;
            background: #fff;
            padding: 15px 20px;
            border-radius: 8px;
            box-shadow: 0 4px 10px rgba(0,0,0,.08);
            transition: .3s ease;
        }

        .certification-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 8px 16px rgba(0,0,0,.15);
            background: #f0f6ff;
            cursor: pointer;
        }

        .certification-card-icon {
            width: 50px;
            height: 50px;
            margin-right: 20px;
            flex-shrink: 0;
        }

        .certification-card-icon img {
            width: 100%;
            height: 100%;
            object-fit: contain;
        }

        .certification-card-text {
            font-size: 1rem;
            font-weight: 600;
            color: #333;
        }

        .certification-card-link {
            text-decoration: none;
            color: inherit;
            display: block;
            outline: none;
            border: none;
        }

        .certification-card-link:focus,
        .certification-card-link:active {
            outline: none;
            border: none;
        }

        /* ===================================================== */
        /* SAGIP DAGAT FEATURED LAUNCH SECTION STYLES */
        /* ===================================================== */
        .sagip-highlight-wrapper {
            margin: 25px 20px 0 20px;
            background: #ffffff;
            border-radius: 12px;
            padding: 30px;
            box-shadow: 0 10px 25px rgba(3, 54, 157, 0.12);
            border: 2px solid #e1e9f8;
            position: relative;
            overflow: hidden;
        }

        .sagip-highlight-wrapper::before {
            content: "";
            position: absolute;
            top: 0;
            left: 0;
            width: 6px;
            height: 100%;
            background: linear-gradient(180deg, #03369D 0%, #00a8ff 100%);
        }

        .sagip-badge {
            display: inline-block;
            background: #e6f0ff;
            color: #03369D;
            font-size: 12px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 1px;
            padding: 5px 12px;
            border-radius: 20px;
            margin-bottom: 20px;
        }

        .sagip-grid {
            display: grid;
            grid-template-columns: 300px 1fr;
            gap: 30px;
            align-items: center;
        }

        .sagip-left-card {
            background: linear-gradient(145deg, #f8fafc, #edf2f7);
            border: 1px solid #e2e8f0;
            border-radius: 12px;
            padding: 25px;
            text-align: center;
            display: flex;
            flex-direction: column;
            align-items: center;
