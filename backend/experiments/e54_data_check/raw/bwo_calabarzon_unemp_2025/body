document.addEventListener('DOMContentLoaded', function () {

  // ---- Swap thumbnail images for higher-res versions ----
  function upgradeImageSrc(img) {
    var original = img.getAttribute('src');
    if (!original) return;

    // Only bother if it's a WP-generated thumbnail size like -150x150
    var match = original.match(/^(.*)-(\d+)x(\d+)(\.\w+)$/);
    if (!match) return; // not a sized thumbnail (e.g. already full-res), skip

    var base = match[1];       // everything before -150x150
    var ext = match[4];        // .jpg / .png / etc.

    // Candidate sizes to try, largest to smallest fallback chain
    var candidates = [
      base + '-1024x1024' + ext,
      base + '-768x768' + ext,
      base + '-600x600' + ext,
      base + ext,               // full original, no suffix
    ];

    tryNext(img, candidates, 0, original);
  }

  function tryNext(img, candidates, i, fallback) {
    if (i >= candidates.length) {
      img.src = fallback; // give up, restore original thumbnail
      return;
    }
    var testImg = new Image();
    testImg.onload = function () {
      img.src = candidates[i]; // found a working larger version
    };
    testImg.onerror = function () {
      tryNext(img, candidates, i + 1, fallback); // try the next smaller candidate
    };
    testImg.src = candidates[i];
  }

  document.querySelectorAll('.gallery .attachment-thumbnail').forEach(upgradeImageSrc);

  // ---- Build the slider (same as before) ----
  document.querySelectorAll('.gallery').forEach(function (gallery) {

    var wrap = document.createElement('div');
    wrap.className = 'slider-wrap';
    gallery.parentNode.insertBefore(wrap, gallery);
    wrap.appendChild(gallery);

    var slides = Array.from(gallery.children);
    if (slides.length <= 1) return;

    var prevBtn = document.createElement('button');
    prevBtn.className = 'slider-btn prev';
    prevBtn.innerHTML = '&#10094;';
    prevBtn.setAttribute('aria-label', 'Previous slide');

    var nextBtn = document.createElement('button');
    nextBtn.className = 'slider-btn next';
    nextBtn.innerHTML = '&#10095;';
    nextBtn.setAttribute('aria-label', 'Next slide');

    wrap.appendChild(prevBtn);
    wrap.appendChild(nextBtn);

    var dotsWrap = document.createElement('div');
    dotsWrap.className = 'slider-dots';
    slides.forEach(function (_, i) {
      var dot = document.createElement('button');
      dot.setAttribute('aria-label', 'Go to slide ' + (i + 1));
      if (i === 0) dot.classList.add('active');
      dot.addEventListener('click', function () { goTo(i); });
      dotsWrap.appendChild(dot);
    });
    wrap.appendChild(dotsWrap);

    var dots = Array.from(dotsWrap.children);

    function currentIndex() {
      return Math.round(gallery.scrollLeft / gallery.clientWidth);
    }

    function goTo(index) {
      var clamped = Math.max(0, Math.min(index, slides.length - 1));
      gallery.scrollTo({ left: clamped * gallery.clientWidth, behavior: 'smooth' });
    }

    function updateDots() {
      var idx = currentIndex();
      dots.forEach(function (d, i) { d.classList.toggle('active', i === idx); });
    }

    prevBtn.addEventListener('click', function () { goTo(currentIndex() - 1); });
    nextBtn.addEventListener('click', function () { goTo(currentIndex() + 1); });

    var scrollTimeout;
    gallery.addEventListener('scroll', function () {
      clearTimeout(scrollTimeout);
      scrollTimeout = setTimeout(updateDots, 80);
    });

    window.addEventListener('resize', function () { goTo(currentIndex()); });
  });
});
