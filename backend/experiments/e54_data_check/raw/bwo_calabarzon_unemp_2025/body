			}
		} );
	} );

	function cscoInitAdSlots() {
		var pending = document.querySelectorAll( '[data-csco-ad-base]:not([data-csco-ad-done])' );

		if ( ! pending.length ) {
			return;
		}

		pending.forEach( function( el ) {
			el.setAttribute( 'data-csco-ad-done', '1' );
		} );

		googletag.cmd.push( function() {
			// Each post loaded by infinite scroll is still, as far as GAM is
			// concerned, part of the SAME pageview as the one the page loaded
			// with. Without a fresh correlator, a repeated ad unit (e.g. AD1
			// showing again for post #2) gets treated as competing with
			// itself and silently comes back no-fill instead of requesting a
			// new creative. Skip it on the very first load, since that one
			// already matches the real pageview.
