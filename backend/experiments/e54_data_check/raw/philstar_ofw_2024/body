<!-- Fix broken tn/tiny images in Banner, Related Stories, More Sections & Video -->
<script type="4d7d4dfe08ecfc92c40aedaa-text/javascript">
(function () {
    const SELECTOR =
        '.ribbon_image img,' +
        '#moreArticleinSection img,' +
        '#related_block img,' +
        '.carousel__item__image img,' +
        '#video_box-content img';
    function fixImage(img) {
        if (!img || img.tagName !== 'IMG') return;
        // Prevent repeated repair attempts
        if (img.dataset.repaired === '1') return;
        const src = img.getAttribute('src') || '';
        const dataSrc = img.getAttribute('data-src') || '';
        // Use the actual URL first
        const oldUrl = src || dataSrc;
        if (!oldUrl) return;
        /* IMPORTANT: Only change the URL AFTER the image has failed. * Example: xxxx_tiny.jpg xxxx_tn.jpg */
        let newUrl = oldUrl;
        // Remove extra digits immediately before _tiny.jpg
        newUrl = newUrl.replace(
            /(\d{2}-\d{2}-\d{2})\d+(_tiny\.jpg)$/i,
            '$1$2'
        );
        // Remove extra digits immediately before _tn.jpg
        newUrl = newUrl.replace(
            /(\d{2}-\d{2}-\d{2})\d+(_tn\.jpg)$/i,
            '$1$2'
        );
        // Nothing to repair
        if (newUrl === oldUrl) {
            console.warn(
                'Broken image but no matching tn/tiny pattern:',
                oldUrl
            );
            img.dataset.repaired = '1';
            return;
        }
        console.log('Broken image detected');
        console.log('OLD:', oldUrl);
        console.log('NEW:', newUrl);
        img.dataset.repaired = '1';
        // Update lazy-load URL
        if (dataSrc) {
            img.setAttribute('data-src', newUrl);
        }
        // Update actual image
        img.setAttribute('src', newUrl);
    }
    /* Catch image errors. * Capture mode = true is important because it also * catches dynamically loaded images. */
    document.addEventListener('error', function (event) {
        const img = event.target;
        if (img && img.tagName === 'IMG' && img.matches(SELECTOR)) {
            fixImage(img);
        }
    }, true);
    /* Check images already present on the page. */
    function scanImages(root) {
        if (!root) return;
        // Root itself
        if (root.nodeType === 1 && root.tagName === 'IMG' && root.matches(SELECTOR)) {
            if (root.complete && root.naturalWidth === 0) {
                fixImage(root);
            }
        }
        // Images inside root
        if (root.querySelectorAll) {
            root.querySelectorAll(SELECTOR).forEach(function (img) {
                if (
                    img.complete &&
                    img.naturalWidth === 0
                ) {
                    fixImage(img);
                }
            });
        }
    }
    /* Initial scan */
    scanImages(document);
    /* Watch AJAX / dynamically loaded content. */
    const observer = new MutationObserver(function (mutations) {
        mutations.forEach(function (mutation) {
            mutation.addedNodes.forEach(function (node) {
                if (node.nodeType === 1) {
                    scanImages(node);
                }
            });
        });
    });
    observer.observe(document.body, {
        childList: true,
        subtree: true
    });
})();
</script>

