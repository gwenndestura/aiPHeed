# aiPHeed deployment: quarterly self-update (thesis Rule 1, p.48; schedule p.59).
# Copy the lines you need into the deployed backend environment. Every value here is OFF in the code by default.

# Start APScheduler with the app (default 0 = off).
AIPHEED_ENABLE_SCHEDULER=1

# Quarterly cycle: 02:00 Philippine time (the scheduler runs in Asia/Manila) on the 15th of January, April,
# July and October. The code default hour is 3; the thesis states 02:00.
AIPHEED_QUARTERLY_CRON_MONTHS=1,4,7,10
AIPHEED_QUARTERLY_CRON_DAY=15
AIPHEED_QUARTERLY_CRON_HOUR=2

# First deployment check: run each scheduled cycle in a temporary copy and write nothing (default 0).
# Remove or set to 0 once the dry runs report what you expect.
AIPHEED_SCHEDULER_DRY_RUN=1

# Note: the daily news job also runs at 02:00 (NEWS_CRON_HOUR in app/tasks/scheduler.py). Both jobs are
# max_instances=1 but are not serialised with each other.

# Optional: rebuild the served E49-family record each quarter (scripts/rebuild_served_record.py) into
# data/rebuild/<YYYYMMDD>/ (never data/e49/; nothing is served automatically). Default 0 = off.
# With AIPHEED_SCHEDULER_DRY_RUN=1 it builds in a temporary directory instead and keeps nothing.
AIPHEED_REBUILD_RECORD=0
AIPHEED_REBUILD_CRON_HOUR=4
