# Basemap tile file location. Defaults to /basemap.pmtiles (public/basemap.pmtiles).
# In production point this at the agency CDN / object store.
VITE_BASEMAP_PMTILES_URL=/basemap.pmtiles

# Backend API origin. Every VITE_* value is public (bundled into the client
# JS), so this only ever names where the API lives, never a secret.
VITE_API_BASE_URL=http://localhost:8000
