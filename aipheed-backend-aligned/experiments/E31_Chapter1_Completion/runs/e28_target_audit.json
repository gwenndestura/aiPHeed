 "what_the_target_can_support": [
  "a regional (Balance Luzon) statement about whether self-rated hunger plus local food-price pressure is above its recent median, issued per province",
  "province-to-province differences only through the price term 2D (34-35% of the label variance)"
 ],
 "what_it_cannot_support": [
  "a measured provincial or municipal food-insecurity rate",
  "a horizon reliability claim under the C6 rule: no lead has >= 5 LOW rows (by lead: 1: 4, 2: 2, 3: 2, 4: 2, 5: 1, 6: 1)",
  "five independent provincial evaluations per quarter"
 ],
 "what_would_be_needed": [
  "more quarters with LOW outcomes under the approved rule (each future quarter adds one regional date); at least 5 LOW and 8 dates per lead",
  "a provincial outcome measured with known sampling error: CBMS LGU FIES (O1) or NNS 2023 provincial FIES (O2)",
  "per-round Balance Luzon sample sizes (O5a) to quantify label noise exactly"
 ]
}